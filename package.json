{
  "name": "@shadow-js/motion",
  "version": "1.0.4",
  "description": "Tween and spring values, exit animations and animated list reordering, driven by signals",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/dev/index.d.ts",
      "development": "./dist/dev/index.js",
      "default": "./dist/prod/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test-types.json",
    "typecheck:types": "tsc -p tsconfig.test-types.json",
    "lint": "biome check .",
    "test": "vitest run --project unit --project dom --project server",
    "test:gc": "vitest run --project gc --passWithNoTests",
    "test:perf": "vitest run --project perf --passWithNoTests",
    "check": "npm run lint && npm run typecheck && npm run build && npm test && npm run test:perf && npm run test:gc"
  },
  "peerDependencies": {
    "@shadow-js/core": "^1.0.4",
    "@shadow-js/web": "^1.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@shadow-js/core": "^1.0.4",
    "@shadow-js/web": "^1.0.4",
    "@types/node": "^24.0.0",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.3",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "homepage": "https://motion.shadowjs.net",
  "keywords": [
    "shadowjs",
    "motion"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shadowjs-dev/motion.git"
  },
  "bugs": {
    "url": "https://github.com/shadowjs-dev/motion/issues"
  }
}
